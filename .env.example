# Copy this file to .env and fill in the values. .env is git-ignored.

# Claude API key used to read the order image.
# Create one at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Claude model used for extraction.
EXTRACTION_MODEL=claude-opus-5-5

# Full path to Fakturama.exe. Only needed if the automation should start Fakturama itself;
# otherwise start Fakturama by hand before running.
FAKTURAMA_EXE=

# Seconds to wait for a Fakturama screen or control to appear (default 15), and for
# Fakturama itself to start when FAKTURAMA_EXE is set (default 120).
UI_TIMEOUT=
STARTUP_TIMEOUT=
